# Signing keys — the updater's private key is the one unrecoverable secret in this project
*.key
*.pem
*.p12
.tauri/

# Tauri-generated ACL schemas (regenerated on every build)
src-tauri/gen/schemas/

# Agent/tooling scratch
.claude/

# Downloaded/built artifacts. A 17MB arm.tar.gz once reached a commit through `git add -A`
# and was copied straight into the public export — the export denylist matched names, not
# file kinds, so nothing stopped it.
*.tar.gz
*.tgz
*.dmg
*.msi
*.zip

# Private service/site source lives only in auto-translate-desktop, never this public tree.
/landing/
/server/
/worker/