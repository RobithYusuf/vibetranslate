dist/
dist-ssr/

# Tauri
src-tauri/target/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Cache
.cache/
*.tsbuildinfo

# VAD assets — generated into public/ by scripts/copy-vad-assets.mjs (predev/prebuild)
public/vad.worklet.bundle.min.js
public/silero_vad_v5.onnx
public/silero_vad_legacy.onnx
public/ort-wasm-simd-threaded.mjs
