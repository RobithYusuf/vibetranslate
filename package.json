{
  "name": "vibetranslate",
  "version": "1.0.46",
  "description": "AI translation and voice dictation for macOS and Windows — select text or speak, get the result pasted back in place. Works offline.",
  "license": "AGPL-3.0-only",
  "author": "Robith Yusuf",
  "homepage": "https://vibetranslate.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/RobithYusuf/vibetranslate.git"
  },
  "bugs": {
    "url": "https://github.com/RobithYusuf/vibetranslate/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "copy-vad-assets": "node scripts/copy-vad-assets.mjs",
    "predev": "node scripts/copy-vad-assets.mjs",
    "prebuild": "node scripts/copy-vad-assets.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "_comment:build:local": "Contributors have no updater signing key, and tauri build fails without one because createUpdaterArtifacts is on. This overlay turns updater artifacts off. A config FILE rather than inline JSON: the shell eats the quotes when npm runs the script, and it breaks differently again on Windows.",
    "build:local": "tauri build --config src-tauri/tauri.local.conf.json"
  },
  "dependencies": {
    "@cloudworxx/tauri-plugin-mac-rounded-corners": "^1.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-autostart": "^2.2.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "lucide-react": "^0.469.0",
    "onnxruntime-web": "^1.27.0",
    "openai": "^4.77.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
